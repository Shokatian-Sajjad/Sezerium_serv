# =============================================================================
# OpenTopography & DEM Configuration
# =============================================================================
# Request a free API key at: https://portal.opentopography.org/
OPENTOPOGRAPHY_API_KEY=your_opentopography_api_key_here

# Preferred DEM Provider: "opentopography" or "aws_s3"
DEM_PROVIDER=opentopography

# Default DEM Dataset (e.g., COP30, SRTMGL1, AW3D30, NASADEM)
DEFAULT_DEM_TYPE=COP30


# =============================================================================
# JWT Authentication & Client Access
# =============================================================================
# Pre-shared client API key required to obtain JWT bearer tokens via /api/v1/auth/token
CLIENT_API_KEY=sez_secret_client_key_change_me

# Secret key used to sign and verify JWT tokens (HMAC-SHA256)
JWT_SECRET_KEY=generate_a_secure_random_jwt_secret_key_here

# JWT token expiration in minutes (default: 1440 mins / 24 hours)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440


# =============================================================================
# IP-Based Rate Limiting
# =============================================================================
# Format: "<number>/<second|minute|hour|day>"
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_CROP=60/minute
RATE_LIMIT_AUTH=10/minute
